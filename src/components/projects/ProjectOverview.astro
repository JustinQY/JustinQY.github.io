---
import type { CollectionEntry } from 'astro:content';
import ProjectResources from './ProjectResources.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  showResources?: boolean;
}

const { project, showResources = true } = Astro.props;
const { data } = project;
const metadata = [
  { label: 'Organization', value: data.organization },
  { label: 'My role', value: data.role },
  { label: 'Period', value: data.period },
].filter((item) => item.value);
---

{
  (metadata.length > 0 || data.outcome || (showResources && data.links.length > 0)) && (
    <div class="project-overview">
      {metadata.length > 0 && (
        <dl>
          {metadata.map((item) => (
            <div>
              <>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </>
            </div>
          ))}
        </dl>
      )}
      {data.outcome && (
        <div class="project-impact">
          <>
            <span>Selected impact</span>
            <p>{data.outcome}</p>
          </>
        </div>
      )}
      {showResources && <ProjectResources links={data.links} />}
    </div>
  )
}

<style>
  .project-overview .review-note {
    margin: 0 0 22px;
    padding: 14px 16px;
    border: 1px dashed var(--paper-line-strong);
    border-radius: 7px;
    background: var(--paper-surface-muted);
    color: var(--paper-ink-soft);
    font-size: 0.8rem;
    line-height: 1.75;
  }
  .project-overview {
    margin-bottom: 34px;
    font-family: var(--font-ui-label);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 24px 0 0;
  }
  dt,
  .project-impact span {
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
  }
  dd {
    margin: 4px 0 0;
    color: var(--paper-ink);
    font-size: 0.88rem;
  }
  .project-impact {
    margin-top: 24px;
    padding: 18px;
    border-left: 2px solid var(--paper-accent);
    background: var(--paper-surface-muted);
  }
  .project-impact p {
    margin: 6px 0 0;
    font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    dl {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
